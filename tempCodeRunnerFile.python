

print("Olá, seja bem-vindo ao programa de cálculo de porções de comida!")

porcao = int(input("Quantos gramas tem cada porção de comida? "))
comprou = int(input("Quantas porções de comida você comprou? "))
qtd_dia = int(input("Quantos gramas você consome por dia? "))

dio = int((porcao*comprou)/qtd_dia)

print(f'Você terá {dio} dias de comida.')

