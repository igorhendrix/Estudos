# atividade 1

def funcao1(x,y):
    conta = x-y
    return conta

saldo = "1000"
numero = int(saldo)

resgate = int(input("Quanto deseja resgatar? "))

pergunta = input("Quer ver seu saldo agora? ")

if 'S' in pergunta.upper():
    saldo_atual = funcao1(numero, resgate)
    print(f"seu saldo atual é R${saldo_atual}")