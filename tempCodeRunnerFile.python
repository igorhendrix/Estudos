# atividade 1

def resgatando(saldo, resgate):
    conta = saldo - resgate
    return conta

def printSaldo(saldo):
    print(f"Seu saldo é de R${saldo:.2f}")

saldo = 10000



print(" ---------- Bem vindo ao Banco! ---------- ")

i=1
while i!=0:

    print("\nDigite o que deseja fazer: ")
    opcao = input("[1] Ver saldo atual\n[2] Resgatar dinheiro\n[0]Sair do sistema\n")

    i = opcao

    if opcao == 1:
        printSaldo(saldo)
        

    if opcao == 2:
        resgate = int(input("Quanto deseja resgatar? "))
        resgatando(saldo, resgate)
        
